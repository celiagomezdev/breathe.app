# Supabase — copy this to .env.local and fill in your project values.
# Find these in: Supabase dashboard → Project Settings → API
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_PUBLISHABLE_KEY=your-publishable-key-here
CAPACITOR_SERVER_URL=https://your-deployed-url.com

# CARTO basemap tiles — request a free key at https://carto.com/basemaps/apikey (no account needed).
VITE_CARTO_API_KEY=your-carto-api-key-here
